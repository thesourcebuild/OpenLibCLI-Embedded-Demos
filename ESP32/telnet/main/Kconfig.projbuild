menu "OpenLibCLI Telnet Demo Configuration"

    config CLI_LED_GPIO
        int "Built-in LED GPIO number"
        range 0 48
        default 8 if IDF_TARGET_ESP32C3 || IDF_TARGET_ESP32C6 || IDF_TARGET_ESP32H2
        default 48 if IDF_TARGET_ESP32S3
        default 2
        help
            GPIO number for the built-in LED. The default follows the target's
            common dev board: ESP32 DevKitC=2, ESP32-C3/C6/H2 DevKitM=8,
            ESP32-S3 DevKitC=48.
endmenu
