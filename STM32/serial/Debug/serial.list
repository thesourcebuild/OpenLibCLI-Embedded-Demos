OPENLIBCLI_API cli_priv_t cli_get_privilege(const cli_struct_t *cli) {
  /* Fail closed: an unknown session has the lowest privilege. */
  return (cli != NULL) ? cli->privilege : CLI_PRIV_USER;
}

